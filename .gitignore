# Root .gitignore for WeCheaperTours (Full-stack Laravel + React)

# Dependencies
**/node_modules/
**/vendor/

# Environment files
**/.env
**/.env.backup
**/.env.production
**/.env.local
**/.env.*.local

# Build outputs
**/dist/
**/dist-ssr/
backend/public/build/
backend/public/hot/

# Storage & Cache (Laravel)
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/public/storage

# Database
*.sqlite
*.sqlite-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
